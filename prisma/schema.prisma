generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trainer {
  id                       String            @id @default(uuid())
  authUserId               String?           @unique @map("auth_user_id")
  name                     String
  email                    String            @unique
  studentRegistrationToken String?           @unique @map("student_registration_token")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  students                 Student[]
  trainingRoutines         TrainingRoutine[]

  @@map("trainers")
}

model TrainingRoutine {
  id                 String                @id @default(uuid())
  trainerId          String                @map("trainer_id")
  name               String
  startDate          DateTime?             @map("start_date") @db.Date
  endDate            DateTime?             @map("end_date") @db.Date
  removeOnExpiration Boolean               @default(false) @map("remove_on_expiration")
  instructions       String?
  status             TrainingRoutineStatus @default(draft)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")
  trainer            Trainer               @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, deletedAt, status])
  @@index([trainerId, createdAt, id])
  @@map("training_routines")
}

model Student {
  id                 String                    @id @default(uuid())
  trainerId          String                    @map("trainer_id")
  fullName           String                    @map("full_name")
  phone              String                    @unique
  birthDate          DateTime                  @map("birth_date") @db.Date
  gender             StudentGender
  status             StudentStatus             @default(active)
  registrationSource StudentRegistrationSource @default(trainer) @map("registration_source")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")
  trainer            Trainer                   @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, deletedAt, status])
  @@index([trainerId, fullName, id])
  @@map("students")
}

enum StudentGender {
  male
  female
  nonBinary      @map("non_binary")
  preferNotToSay @map("prefer_not_to_say")

  @@map("student_gender")
}

enum StudentStatus {
  active
  inactive

  @@map("student_status")
}

enum StudentRegistrationSource {
  trainer
  selfRegistration @map("self_registration")

  @@map("student_registration_source")
}

enum TrainingRoutineStatus {
  draft
  active
  archived

  @@map("training_routine_status")
}
